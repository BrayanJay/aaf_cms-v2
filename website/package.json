{
  "name": "asiaassetfinance",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run generate:sitemap && vite build",
    "postbuild": "react-snap",
    "build:uat": "node scripts/generate-og-meta.js && vite build && cp public-uat/.htaccess dist/.htaccess",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "generate:og-meta": "node scripts/generate-og-meta.js",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "reactSnap": {
    "source": "dist",
    "destination": "dist",
    "crawl": false,
    "include": [
      "/",
      "/about",
      "/ir",
      "/branchnetwork",
      "/gold-loan",
      "/fixed-deposit",
      "/leasing",
      "/mortgage",
      "/foreign-exchange",
      "/luckewallet",
      "/careers",
      "/contacts",
      "/contacts/complaints",
      "/customer-complaints",
      "/downloads",
      "/downloads/customer-information",
      "/downloads/luckewallet-guidelines",
      "/downloads/privacy-policy",
      "/app-privacy-policy",
      "/news-and-events",
      "/promotions",
      "/news-and-events/article/asia-asset-finance-2025-q1-growth",
      "/news-and-events/article/asia-asset-finance-55th-and-northern-province-15th-anniversary",
      "/news-and-events/article/creating-smiles-hope-asia-asset-finance-childrens-day-apeksha-cancer-hospital-2025",
      "/news-and-events/article/asia-asset-finance-champions-women-empowerment-with-breast-cancer-awareness-for-tea-estate-workers-ginigathhena-2025",
      "/news-and-events/article/asia-asset-finance-plc-clinches-four-awards-national-project-management-excellence-awards-2025",
      "/news-and-events/article/asia-asset-finance-continues-shine-rapid-growth-business-pbt-exceeding-lkr-980mn-yoy-2025",
      "/news-and-events/article/growth-with-purpose-conversation-roshan-gunasekara-executive-director-chief-operating-officer-2026",
      "/news-and-events/article/asia-asset-finance-plc-delivers-strong-q3-performance-2025",
      "/profile/1",
      "/profile/2",
      "/profile/3",
      "/profile/4",
      "/profile/5",
      "/profile/6",
      "/profile/7",
      "/profile/8",
      "/profile/9",
      "/profile/10",
      "/profile/11",
      "/profile/12",
      "/profile/13",
      "/profile/14",
      "/profile/15",
      "/profile/16"
    ],
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ],
    "skipThirdPartyRequests": true,
    "renderAfterTime": 2000,
    "minifyHtml": {
      "collapseWhitespace": false,
      "removeComments": false
    }
  },
  "dependencies": {
    "@fontsource/noto-sans-sinhala": "^5.1.1",
    "@fontsource/noto-sans-tamil": "^5.1.1",
    "@fontsource/roboto": "^5.1.0",
    "@fortawesome/fontawesome-svg-core": "^6.7.1",
    "@fortawesome/free-brands-svg-icons": "^6.7.1",
    "@fortawesome/free-regular-svg-icons": "^6.7.1",
    "@fortawesome/free-solid-svg-icons": "^6.7.1",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@headlessui/react": "^2.2.0",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@vitejs/plugin-legacy": "^6.0.0",
    "aos": "^2.3.4",
    "careers": "file:../careers",
    "emailjs-com": "^3.2.0",
    "i18next": "^24.0.5",
    "i18next-http-backend": "^3.0.1",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-feather": "^2.0.10",
    "react-helmet": "^6.1.0",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^15.1.3",
    "react-icons": "^5.4.0",
    "react-router-dom": "^6.27.0",
    "react-router-hash-link": "^2.4.3",
    "smoothscroll-polyfill": "^0.4.4",
    "swiper": "^11.1.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.13.0",
    "postcss": "^8.4.49",
    "react-snap": "^1.23.0",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.6",
    "vite-plugin-pages": "^0.33.3"
  }
}
